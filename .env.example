# Server-only secrets — do not use NEXT_PUBLIC_ for these.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Public site URL used for canonicals, sitemap, Open Graph, and JSON-LD.
# Staging can use another HTTPS origin. Do not use localhost here.
NEXT_PUBLIC_SITE_URL=https://naptacademy.com

# Server-only. true allows crawling and indexing. false forces noindex, nofollow.
# Staging and local copies should use false.
ALLOW_INDEXING=true
